import vm NativeOwnedSubmenuModel
Window {
    VStack {
        Label(id: "anchor", text: "Actions")
        Menu(id: "parent", targetId: "anchor", onItemTriggered: vm.parentTriggered, onClosed: vm.parentClosed) {
            MenuItem(id: "more", label: "More", enabled: vm.moreEnabled, hasChildItems: vm.hasChildren, showChevron: vm.showChevron, onClick: vm.moreClicked) {
                ContextMenu(id: "child", onOpened: vm.childOpened, onClosed: vm.childClosed, onItemTriggered: vm.childTriggered) {
                    ContextMenuItem(id: "leaf", label: "Leaf", hasChildItems: false, onClick: vm.leafClicked)
                    ContextMenuItem(id: "middle", label: "More") {
                        Menu(id: "grandchild") {
                            MenuItem(id: "deep", label: "Deep", hasChildItems: false, onClick: vm.deepClicked)
                        }
                    }
                }
            }
            MenuItem(id: "other", label: "Other", onClick: vm.otherClicked) {
                Menu(id: "other-child", onOpened: vm.otherOpened) {
                    MenuItem(id: "other-leaf", label: "Other leaf", hasChildItems: false)
                }
            }
            MenuItem(id: "plain", label: "Plain", hasChildItems: false, onClick: vm.plainClicked)
            MenuItem(id: "disabled", label: "Disabled", enabled: false) {
                Menu(id: "disabled-child") {
                    MenuItem(id: "disabled-leaf", label: "Disabled leaf", hasChildItems: false)
                }
            }
        }
    }
}
