import vm NativeFactoryCaptureBackend
Window { VStack {
    PushButton(id: "temporary", onClick: callback(vm.temporary().make()))
    PushButton(id: "owned_temporary", onClick: callback(vm.temporary().value()))
    PushButton(id: "argument", onClick: callback(vm.capture(vm.argument())))
    PushButton(id: "mixed", onClick: callback(vm.mixed(vm.argument(), vm.argument())))
} }
