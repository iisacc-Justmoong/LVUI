import vm NativeOwnedHierarchyListModel
Window {
    HStack(spacing: 8, alignment: .top) {
        HierarchyList(id: "tree", controller: vm.controller, editor: vm.editor, editable: vm.editable, modelRevision: vm.revision,
                      width: vm.width, height: 100, rowHeight: 20, overscan: 1,
                      keyboardNavigationEnabled: vm.keyboard,
                      onActiveChanged: vm.activated, onExpansionChanged: vm.expanded, onItemMoved: vm.moved)
        HierarchyList(id: "empty", width: 120, height: 100)
    }
}
