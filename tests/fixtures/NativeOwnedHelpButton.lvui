import vm NativeOwnedHelpButtonModel
Window {
    VStack {
        HelpButton(id: "help", onClick: vm.open)
        HelpButton(id: "custom", text: vm.text, width: vm.width, enabled: vm.enabled,
                   motionEnabled: vm.motion_enabled, enterKeyActivation: vm.enter_enabled, onClick: vm.open,
                   onPressed: vm.press, onReleased: vm.release, onCanceled: vm.cancel,
                   method: vm.method, methods: [vm.after, [vm.last]])
    }
}
