import vm NativeReturnedBackend
let Action: View = PushButton(text: "Action")
Window {
    VStack {
        PushButton(id: "direct", onClick: callback(vm.make(vm.amount)))
        Action(id: "supplied", onClick: callback(vm.make(vm.amount + 1)))
        InputField(id: "text", text: "", onEdited: callback(vm.makeText()))
        if (vm.visible) {
            VStack {
                import local NativeReturnedBackend
                Action(id: "nested", onClick: callback(vm.make(vm.amount + 2)))
                PushButton(id: "local", onClick: callback(local.make(local.amount)))
            }
        }
    }
}
