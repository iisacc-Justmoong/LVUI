import vm NativeImageLoaderViewsModel
Window {
    VStack {
        Image(id: "image", source: vm.url, imageLoader: vm.loader, width: 20, height: 10)
        Avatar(id: "avatar", source: vm.url, imageLoader: vm.loader, size: .Small)
        Card(id: "card", type: .FilePreview, previewSource: vm.url, imageLoader: vm.loader, width: 100, height: 80)
        ListItem(id: "item", type: .Media, previewSource: vm.url, imageLoader: vm.loader, width: 300)
    }
}
