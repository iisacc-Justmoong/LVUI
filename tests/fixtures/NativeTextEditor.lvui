import vm NativeTextEditorModel
Window {
    VStack {
        TextEditor(id: "notes", text: vm.text, placeholder: vm.placeholder, width: vm.width,
                   height: vm.height, minimumHeight: vm.minimumHeight, verticalPadding: vm.inset,
                   enabled: vm.enabled, readOnly: vm.readOnly, onEdited: vm.edited,
                   onContentHeightChanged: vm.measured)
    }
}
