import vm NativeOwnedSegmentedControlModel
let Piece(title: String): View = VStack { LabelButton(id: "pieceButton", text: title) }
Window {
    VStack {
        LabelSegmentedControl(id: "group", forceBorderlessTone: vm.force, spacing: vm.spacing,
                              enabled: vm.enabled, shapeStyle: vm.shape) {
            LabelButton(id: "first", text: "One", tone: vm.tone, onClick: vm.clicked)
            LabelButton(id: "second", text: "Two", onClick: vm.clicked)
            VStack(id: "nested") { LabelButton(id: "nestedButton", text: "Nested", onClick: vm.clicked) }
            Piece(title: "Piece")
            HelpButton(id: "nestedHelp", onClick: vm.clicked)
            if (vm.show) { LabelButton(id: "conditional", text: "Conditional", onClick: vm.clicked) }
            for (item in vm.items, key: item.id, id: "rows", horizontal: true) {
                LabelButton(id: "repeated", text: item.label, onClick: vm.clicked)
            }
            LabelSegmentedControl(id: "inner", forceBorderlessTone: vm.innerForce) {
                LabelButton(id: "innerButton", text: "Inner", onClick: vm.clicked)
            }
        }
        IconSegmentedControl(id: "icons", forceBorderlessTone: false) {
            IconButton(id: "icon", icon: vm.icon, accessibilityName: "Tool", onClick: vm.clicked)
        }
    }
}
