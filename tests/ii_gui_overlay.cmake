set(header "${OVERLAY}/iiGUI/NativeWidgets.h")
if(NOT EXISTS "${header}")
    message(FATAL_ERROR "iiGUI source overlay is missing its widget header")
endif()
file(READ "${header}" contents)
if(NOT contents MATCHES "${GUI_SOURCE}/src/Widgets/NativeWidgets[.]h")
    message(FATAL_ERROR "iiGUI overlay does not reference the selected source")
endif()
if(contents MATCHES "/iiGUI/build/")
    message(FATAL_ERROR "iiGUI overlay references another project's build directory")
endif()
