set(_arguments)
if(LVUI_AOT_NAME)
    list(APPEND _arguments --name "${LVUI_AOT_NAME}")
endif()
if(LVUI_AOT_EMIT_STYLES)
    list(APPEND _arguments --emit-styles)
    if(LVUI_AOT_NAMESPACE)
        list(APPEND _arguments --namespace "${LVUI_AOT_NAMESPACE}")
    endif()
endif()
if(LVUI_AOT_STYLE_FILE)
    list(APPEND _arguments --style-file "${LVUI_AOT_STYLE_FILE}")
endif()
if(LVUI_AOT_FRAMEWORK)
    list(APPEND _arguments --framework "${LVUI_AOT_FRAMEWORK}")
endif()
foreach(_header IN LISTS LVUI_AOT_INCLUDES)
    list(APPEND _arguments --include "${_header}")
endforeach()
foreach(_mode IN LISTS LVUI_AOT_STYLE_MODES)
    list(APPEND _arguments --style-mode "${_mode}")
endforeach()
execute_process(COMMAND "${LVUI_AOT_COMPILER}" ${_arguments} "${LVUI_AOT_SOURCE}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _code ERROR_VARIABLE _error)
if(NOT _status EQUAL 0)
    message(FATAL_ERROR "LVUI native compilation failed (${_status}):\n${_error}")
endif()
# CMake owns this generated build artifact. Never replace it on compiler failure.
# Preserve dependent C++ objects when recompiling the tool produces identical code.
if(EXISTS "${LVUI_AOT_OUTPUT}")
    file(READ "${LVUI_AOT_OUTPUT}" _previous_code)
    if("${_previous_code}" STREQUAL "${_code}")
        return()
    endif()
endif()
file(WRITE "${LVUI_AOT_OUTPUT}" "${_code}")
