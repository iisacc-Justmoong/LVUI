include_guard(GLOBAL)
function(lvui_generate)
    set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunLVUICompiler.cmake")
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "NAME;SOURCE;OUTPUT_VARIABLE;FRAMEWORK;STYLE_FILE" "INCLUDES;STYLE_MODES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_NAME MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT ARG_SOURCE OR NOT ARG_OUTPUT_VARIABLE)
        message(FATAL_ERROR "lvui_generate requires NAME, SOURCE, OUTPUT_VARIABLE and optional INCLUDES")
    endif()
    if(ARG_FRAMEWORK AND NOT ARG_FRAMEWORK STREQUAL "iiGUI")
        message(FATAL_ERROR "Unsupported native framework '${ARG_FRAMEWORK}'; LVUI uses iiGUI")
    endif()
    if(LVUI_HOST_COMPILER)
        set(_compiler "${LVUI_HOST_COMPILER}")
        set(_dependency "${LVUI_HOST_COMPILER}")
    elseif(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Cross compilation requires LVUI_HOST_COMPILER pointing to a host-native lvui-compile")
    elseif(NOT TARGET LVUI::lvui-compile)
        message(FATAL_ERROR "LVUI compiler tool is unavailable; set LVUI_HOST_COMPILER to a host-native lvui-compile")
    else()
        set(_compiler "$<TARGET_FILE:LVUI::lvui-compile>")
        set(_dependency LVUI::lvui-compile)
    endif()
    cmake_path(ABSOLUTE_PATH ARG_SOURCE BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE _source)
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/${ARG_NAME}.generated.h")
    set(_style_file "")
    if(ARG_STYLE_FILE)
        cmake_path(ABSOLUTE_PATH ARG_STYLE_FILE BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE _style_file)
    endif()
    add_custom_command(OUTPUT "${_output}"
        COMMAND "${CMAKE_COMMAND}" "-DLVUI_AOT_COMPILER=${_compiler}" "-DLVUI_AOT_SOURCE=${_source}"
            "-DLVUI_AOT_OUTPUT=${_output}" "-DLVUI_AOT_NAME=${ARG_NAME}" "-DLVUI_AOT_INCLUDES=${ARG_INCLUDES}"
            "-DLVUI_AOT_FRAMEWORK=${ARG_FRAMEWORK}"
            "-DLVUI_AOT_STYLE_MODES=${ARG_STYLE_MODES}"
            "-DLVUI_AOT_STYLE_FILE=${_style_file}"
            -P "${_runner}"
        DEPENDS "${_source}" ${_style_file} ${_dependency} "${_runner}"
        VERBATIM COMMENT "AOT compiling ${ARG_NAME}.lvui into native C++23")
    set(${ARG_OUTPUT_VARIABLE} "${_output}" PARENT_SCOPE)
endfunction()
function(lvui_add_application target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "NAME;SOURCE;STYLE_FILE;OUTPUT_VARIABLE;CONFIGURE_SOURCE" "INCLUDES;STYLE_MODES;SOURCES;LIBRARIES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR
       NOT target MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT ARG_SOURCE)
        message(FATAL_ERROR "lvui_add_application requires an identifier target and SOURCE")
    endif()
    if(TARGET "${target}")
        message(FATAL_ERROR "lvui_add_application target already exists: ${target}")
    endif()
    if(NOT ARG_NAME)
        set(ARG_NAME "${target}")
    endif()
    if(NOT ARG_NAME MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "lvui_add_application NAME must be a C++ identifier")
    endif()
    if(NOT TARGET LVUI::Native)
        message(FATAL_ERROR "lvui_add_application requires LVUI::Native")
    endif()
    if(NOT TARGET iiSDKCore::Runtime)
        find_package(iiSDKCore 0.20 CONFIG REQUIRED COMPONENTS Runtime)
    endif()
    if(NOT TARGET iiGUI::iiGUI)
        message(FATAL_ERROR "The application must explicitly provide the iiGUI::iiGUI host target")
    endif()
    if(ANDROID AND NOT TARGET iiGUI::AndroidEntry)
        message(FATAL_ERROR "Android LVUI applications require iiGUI::AndroidEntry from an Android iiGUI package")
    elseif(NOT ANDROID AND NOT COMMAND iisdkcore_add_application)
        message(FATAL_ERROR "lvui_add_application requires the iiSDKCore application helper")
    endif()

    set(_arguments NAME "${ARG_NAME}" SOURCE "${ARG_SOURCE}" OUTPUT_VARIABLE _generated)
    if(ARG_INCLUDES)
        list(APPEND _arguments INCLUDES ${ARG_INCLUDES})
    endif()
    if(ARG_STYLE_FILE)
        list(APPEND _arguments STYLE_FILE "${ARG_STYLE_FILE}")
    endif()
    if(ARG_STYLE_MODES)
        list(APPEND _arguments STYLE_MODES ${ARG_STYLE_MODES})
    endif()
    lvui_generate(${_arguments})
    if(ARG_CONFIGURE_SOURCE)
        cmake_path(ABSOLUTE_PATH ARG_CONFIGURE_SOURCE BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE _entry)
        if(NOT EXISTS "${_entry}" OR IS_DIRECTORY "${_entry}")
            message(FATAL_ERROR "lvui_add_application CONFIGURE_SOURCE must name an existing source file")
        endif()
    else()
        set(_entry "${CMAKE_CURRENT_BINARY_DIR}/${target}.application.cpp")
        file(GENERATE OUTPUT "${_entry}" CONTENT
            "#include \"${ARG_NAME}.generated.h\"\n\nii::core::Result<void> ii::runtime::configure_application(Application& app) {\n    return lvui_generated::${ARG_NAME}::configure_application(app);\n}\n")
    endif()
    if(ANDROID)
        add_library("${target}" SHARED "${_entry}" "${_generated}" ${ARG_SOURCES})
        target_compile_features("${target}" PRIVATE cxx_std_23)
        target_link_libraries("${target}" PRIVATE iiGUI::AndroidEntry LVUI::Native ${ARG_LIBRARIES})
        set_target_properties("${target}" PROPERTIES CXX_EXTENSIONS OFF)
    else()
        iisdkcore_add_application("${target}" GUI
            SOURCES "${_entry}" "${_generated}" ${ARG_SOURCES}
            LIBRARIES iiGUI::iiGUI LVUI::Native ${ARG_LIBRARIES})
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        get_target_property(_existing_ios_manifest "${target}" MACOSX_BUNDLE_INFO_PLIST)
        if(NOT _existing_ios_manifest)
            set(_ios_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../resources/platform/ios/LVUIInfo.plist.in")
            if(NOT EXISTS "${_ios_manifest}")
                set(_ios_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ios/LVUIInfo.plist.in")
            endif()
            if(NOT EXISTS "${_ios_manifest}")
                message(FATAL_ERROR "LVUI iOS scene bundle template is missing")
            endif()
            set_target_properties("${target}" PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${_ios_manifest}")
        endif()
    endif()
    set_property(TARGET "${target}" PROPERTY LVUI_APPLICATION TRUE)
    target_include_directories("${target}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
    if(ARG_OUTPUT_VARIABLE)
        set(${ARG_OUTPUT_VARIABLE} "${_generated}" PARENT_SCOPE)
    endif()
endfunction()

# Install a separate desktop application tree; never rewrite the build target.
function(lvui_install_application target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "ADHOC_SIGN" "DESTINATION" "")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT TARGET "${target}")
        message(FATAL_ERROR "lvui_install_application requires an LVUI application target")
    endif()
    get_target_property(_application "${target}" LVUI_APPLICATION)
    if(NOT _application)
        message(FATAL_ERROR "lvui_install_application requires an LVUI application target")
    endif()
    if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Linux|Windows)$")
        message(FATAL_ERROR "lvui_install_application supports desktop macOS, Linux and Windows")
    endif()
    if(ARG_ADHOC_SIGN AND NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        message(FATAL_ERROR "ADHOC_SIGN is only available for macOS applications")
    endif()
    if(NOT DEFINED ARG_DESTINATION)
        set(ARG_DESTINATION ".")
    endif()
    string(REPLACE "\\" "/" ARG_DESTINATION "${ARG_DESTINATION}")
    string(FIND "${ARG_DESTINATION}" "]==]" _delimiter)
    string(FIND "${ARG_DESTINATION}" "$<" _generator_expression)
    if(ARG_DESTINATION STREQUAL "" OR IS_ABSOLUTE "${ARG_DESTINATION}" OR
       ARG_DESTINATION MATCHES "^[A-Za-z]:" OR ARG_DESTINATION MATCHES "(^|/)\\.\\.(/|$)" OR
       ARG_DESTINATION MATCHES "[;\r\n]" OR NOT _delimiter EQUAL -1 OR NOT _generator_expression EQUAL -1)
        message(FATAL_ERROR "lvui_install_application DESTINATION must be a relative path inside the install prefix")
    endif()
    get_target_property(_already_installed "${target}" LVUI_APPLICATION_INSTALL_RULE)
    if(_already_installed)
        message(FATAL_ERROR "lvui_install_application already configured for ${target}")
    endif()
    set_property(TARGET "${target}" PROPERTY LVUI_APPLICATION_INSTALL_RULE TRUE)

    set(_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/LVUIInstallApplication.cmake")
    set(_setup
        "set(LVUI_DEPLOY_SOURCE [==[$<TARGET_FILE:${target}>]==])\n"
        "set(LVUI_DEPLOY_FILE_NAME [==[$<TARGET_FILE_NAME:${target}>]==])\n"
        "set(LVUI_DEPLOY_DESTINATION [==[${ARG_DESTINATION}]==])\n"
        "set(LVUI_DEPLOY_ROOT \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/\${LVUI_DEPLOY_DESTINATION}\")\n"
        "set(LVUI_DEPLOY_TARGET [==[${target}]==])\n"
        "set(LVUI_DEPLOY_PLATFORM [==[${CMAKE_SYSTEM_NAME}]==])\n"
        "set(LVUI_DEPLOY_ADHOC_SIGN [==[${ARG_ADHOC_SIGN}]==])\n")
    string(JOIN "" _setup ${_setup})
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        string(APPEND _setup "set(LVUI_DEPLOY_BUNDLE_SOURCE [==[$<TARGET_BUNDLE_DIR:${target}>]==])\n")
        string(APPEND _setup "set(LVUI_DEPLOY_APP_NAME [==[$<TARGET_BUNDLE_DIR_NAME:${target}>]==])\n")
        install(CODE "${_setup}set(LVUI_DEPLOY_PHASE preflight)\ninclude([==[${_script}]==])")
        install(DIRECTORY "$<TARGET_BUNDLE_DIR:${target}>" DESTINATION "${ARG_DESTINATION}" USE_SOURCE_PERMISSIONS)
    else()
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            set_property(TARGET "${target}" PROPERTY INSTALL_RPATH "$ORIGIN")
        endif()
        install(CODE "${_setup}set(LVUI_DEPLOY_PHASE preflight)\ninclude([==[${_script}]==])")
        install(TARGETS "${target}" RUNTIME DESTINATION "${ARG_DESTINATION}/${target}")
    endif()
    install(CODE "${_setup}set(LVUI_DEPLOY_PHASE finalize)\ninclude([==[${_script}]==])")
endfunction()

function(lvui_generate_styles)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "NAME;SOURCE;NAMESPACE;OUTPUT_VARIABLE" "STYLE_MODES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_NAME MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT ARG_SOURCE OR NOT ARG_OUTPUT_VARIABLE)
        message(FATAL_ERROR "lvui_generate_styles requires NAME, SOURCE, OUTPUT_VARIABLE and optional NAMESPACE")
    endif()
    if(CMAKE_CROSSCOMPILING AND NOT LVUI_HOST_COMPILER)
        message(FATAL_ERROR "Cross compilation requires LVUI_HOST_COMPILER")
    endif()
    if(LVUI_HOST_COMPILER)
        set(_compiler "${LVUI_HOST_COMPILER}")
        set(_dependency "${LVUI_HOST_COMPILER}")
    elseif(NOT TARGET LVUI::lvui-compile)
        message(FATAL_ERROR "LVUI compiler tool is unavailable; set LVUI_HOST_COMPILER to a host-native lvui-compile")
    else()
        set(_compiler "$<TARGET_FILE:LVUI::lvui-compile>")
        set(_dependency LVUI::lvui-compile)
    endif()
    cmake_path(ABSOLUTE_PATH ARG_SOURCE BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE _source)
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/${ARG_NAME}.generated.h")
    set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunLVUICompiler.cmake")
    add_custom_command(OUTPUT "${_output}"
        COMMAND "${CMAKE_COMMAND}" "-DLVUI_AOT_COMPILER=${_compiler}" "-DLVUI_AOT_SOURCE=${_source}"
            "-DLVUI_AOT_OUTPUT=${_output}" "-DLVUI_AOT_NAME=${ARG_NAME}"
            "-DLVUI_AOT_STYLE_MODES=${ARG_STYLE_MODES}"
            "-DLVUI_AOT_EMIT_STYLES=ON" "-DLVUI_AOT_NAMESPACE=${ARG_NAMESPACE}" -P "${_runner}"
        DEPENDS "${_source}" ${_dependency} "${_runner}" VERBATIM)
    set(${ARG_OUTPUT_VARIABLE} "${_output}" PARENT_SCOPE)
endfunction()
