# This file runs at install time, in the consumer's generated install script.
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL LVUI_DEPLOY_PLATFORM)
    message(FATAL_ERROR "LVUI desktop dependency collection must run on the target operating system")
endif()

function(_lvui_validate_bundle_links bundle)
    if(IS_SYMLINK "${bundle}")
        message(FATAL_ERROR "LVUI application bundle must not be a symbolic link: ${bundle}")
    endif()
    if(NOT EXISTS "${bundle}")
        return()
    endif()
    file(REAL_PATH "${bundle}" _root)
    file(GLOB_RECURSE _entries LIST_DIRECTORIES TRUE "${bundle}/*")
    foreach(_entry IN LISTS _entries)
        if(IS_SYMLINK "${_entry}")
            if(NOT EXISTS "${_entry}")
                message(FATAL_ERROR "LVUI application contains a dangling symbolic link: ${_entry}")
            endif()
            file(REAL_PATH "${_entry}" _resolved)
            cmake_path(IS_PREFIX _root "${_resolved}" NORMALIZE _inside)
            if(NOT _inside)
                message(FATAL_ERROR "LVUI application contains a symbolic link outside the bundle: ${_entry}")
            endif()
        endif()
    endforeach()
endfunction()

function(_lvui_patch_elf binary)
    file(REAL_PATH "${binary}" _real)
    cmake_path(IS_PREFIX _lvui_app_dir "${_real}" NORMALIZE _inside)
    if(NOT _inside)
        message(FATAL_ERROR "LVUI runtime binary resolves outside the application directory: ${binary}")
    endif()
    file(CHMOD "${_real}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    execute_process(COMMAND "${_lvui_patchelf}" --print-needed "${_real}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _needed ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect runtime binary ${binary}: ${_error}")
    endif()
    string(REPLACE "\n" ";" _needed "${_needed}")
    foreach(_item IN LISTS _needed)
        if(_item MATCHES "/" AND NOT _item MATCHES "^(/usr/lib|/lib|/lib64|/usr/lib64)(/|$)")
            get_filename_component(_name "${_item}" NAME)
            if(NOT EXISTS "${_lvui_app_dir}/${_name}")
                message(FATAL_ERROR "Cannot relocate runtime dependency ${_item}")
            endif()
            execute_process(COMMAND "${_lvui_patchelf}" --replace-needed "${_item}" "${_name}" "${_real}"
                RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "Cannot relocate runtime dependency ${_item}")
            endif()
        endif()
    endforeach()
    execute_process(COMMAND "${_lvui_patchelf}" --set-rpath "$ORIGIN" "${_real}"
        RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot set the application runtime search path: ${binary}")
    endif()
endfunction()

if(LVUI_DEPLOY_PHASE STREQUAL "preflight")
    if(DEFINED ENV{CMAKE_INSTALL_MODE} AND NOT "$ENV{CMAKE_INSTALL_MODE}" STREQUAL "COPY")
        message(FATAL_ERROR "LVUI application installation requires copy mode")
    endif()
    if(LVUI_DEPLOY_PLATFORM STREQUAL "Darwin")
        _lvui_validate_bundle_links("${LVUI_DEPLOY_BUNDLE_SOURCE}")
        _lvui_validate_bundle_links("${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_APP_NAME}")
        file(REAL_PATH "${LVUI_DEPLOY_BUNDLE_SOURCE}" _lvui_source_bundle)
        file(REAL_PATH "${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_APP_NAME}" _lvui_destination_bundle)
        cmake_path(IS_PREFIX _lvui_source_bundle "${_lvui_destination_bundle}" NORMALIZE _lvui_inside_source)
        cmake_path(IS_PREFIX _lvui_destination_bundle "${_lvui_source_bundle}" NORMALIZE _lvui_contains_source)
        if(_lvui_inside_source OR _lvui_contains_source)
            message(FATAL_ERROR "LVUI installation destination overlaps its build bundle")
        endif()
    else()
        _lvui_validate_bundle_links("${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_TARGET}")
        set(_lvui_destination_binary "${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_TARGET}/${LVUI_DEPLOY_FILE_NAME}")
        if(EXISTS "${_lvui_destination_binary}")
            file(REAL_PATH "${LVUI_DEPLOY_SOURCE}" _lvui_source_binary)
            file(REAL_PATH "${_lvui_destination_binary}" _lvui_destination_binary)
            if(_lvui_source_binary STREQUAL _lvui_destination_binary)
                message(FATAL_ERROR "LVUI installation destination overlaps its build executable")
            endif()
        endif()
    endif()
    if(LVUI_DEPLOY_PLATFORM STREQUAL "Linux")
        find_program(_lvui_patchelf NAMES patchelf)
        if(NOT _lvui_patchelf)
            message(FATAL_ERROR "Installing a Linux LVUI application requires patchelf")
        endif()
    endif()
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${LVUI_DEPLOY_SOURCE}"
        RESOLVED_DEPENDENCIES_VAR _lvui_resolved
        UNRESOLVED_DEPENDENCIES_VAR _lvui_unresolved
        CONFLICTING_DEPENDENCIES_PREFIX _lvui_conflicts
        PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-[Ww][Ii][Nn]-" "^[Ee][Xx][Tt]-[Mm][Ss]-[Ww][Ii][Nn]-")
    if(_lvui_unresolved OR _lvui_conflicts_FILENAMES)
        message(FATAL_ERROR "LVUI application has unresolved or conflicting runtime dependencies: ${_lvui_unresolved}; ${_lvui_conflicts_FILENAMES}")
    endif()
    set(_lvui_dependencies "")
    set(_lvui_dependency_keys "")
    set(_lvui_dependency_key_sources "")
    foreach(_library IN LISTS _lvui_resolved)
        file(TO_CMAKE_PATH "${_library}" _lower)
        string(TOLOWER "${_lower}" _lower)
        get_filename_component(_name "${_lower}" NAME)
        if(_name MATCHES "^(lib)?(qt[0-9a-z]|qml|lvrs)" OR _lower MATCHES "(^|/)lvrs(/|\\.)")
            message(FATAL_ERROR "LVUI application cannot bundle a Qt, QML or LVRS dependency: ${_library}")
        endif()
        if(_lower MATCHES "^(/usr/lib|/lib|/lib64|/usr/lib64|/system/library)(/|$)")
            continue()
        endif()
        if(LVUI_DEPLOY_PLATFORM STREQUAL "Windows" AND DEFINED ENV{SystemRoot})
            file(TO_CMAKE_PATH "$ENV{SystemRoot}" _windows_root)
            string(TOLOWER "${_windows_root}/" _windows_root)
            string(FIND "${_lower}" "${_windows_root}" _windows_prefix)
            if(_windows_prefix EQUAL 0)
                continue()
            endif()
        endif()
        # BundleUtilities flattens names and replaces dots in its internal keys.
        # Detect aliases that it would otherwise silently merge.
        string(REPLACE "." "_" _key "${_name}")
        list(FIND _lvui_dependency_keys "${_key}" _index)
        if(NOT _index EQUAL -1)
            list(GET _lvui_dependency_key_sources ${_index} _previous)
            file(REAL_PATH "${_previous}" _previous_real)
            file(REAL_PATH "${_library}" _library_real)
            if(NOT _previous_real STREQUAL _library_real)
                message(FATAL_ERROR "LVUI application has ambiguous bundled dependency names: ${_previous}; ${_library}")
            endif()
        else()
            list(APPEND _lvui_dependency_keys "${_key}")
            list(APPEND _lvui_dependency_key_sources "${_library}")
        endif()
        list(APPEND _lvui_dependencies "${_library}")
    endforeach()
    if(NOT LVUI_DEPLOY_PLATFORM STREQUAL "Darwin")
        foreach(_library IN LISTS _lvui_dependencies)
            get_filename_component(_name "${_library}" NAME)
            set(_destination "${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_TARGET}/${_name}")
            if(EXISTS "${_destination}")
                file(REAL_PATH "${_library}" _source)
                file(REAL_PATH "${_destination}" _destination)
                if(_source STREQUAL _destination)
                    message(FATAL_ERROR "LVUI installation would modify its source dependency: ${_library}")
                endif()
            endif()
        endforeach()
    endif()
elseif(LVUI_DEPLOY_PHASE STREQUAL "finalize")
    if(LVUI_DEPLOY_PLATFORM STREQUAL "Darwin")
        include(BundleUtilities)
        set(_lvui_app "${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_APP_NAME}")
        _lvui_validate_bundle_links("${_lvui_app}")
        fixup_bundle("${_lvui_app}" "" "")
        if(LVUI_DEPLOY_ADHOC_SIGN)
            find_program(_lvui_codesign NAMES codesign REQUIRED)
            execute_process(COMMAND "${_lvui_codesign}" --force --deep --sign - "${_lvui_app}"
                RESULT_VARIABLE _lvui_sign_result)
            if(NOT _lvui_sign_result EQUAL 0)
                message(FATAL_ERROR "Cannot ad-hoc sign the installed LVUI application")
            endif()
        endif()
    else()
        _lvui_validate_bundle_links("${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_TARGET}")
        file(REAL_PATH "${LVUI_DEPLOY_ROOT}/${LVUI_DEPLOY_TARGET}" _lvui_app_dir)
        if(_lvui_dependencies)
            file(COPY ${_lvui_dependencies} DESTINATION "${_lvui_app_dir}" FOLLOW_SYMLINK_CHAIN)
        endif()
        if(LVUI_DEPLOY_PLATFORM STREQUAL "Linux")
            _lvui_patch_elf("${_lvui_app_dir}/${LVUI_DEPLOY_FILE_NAME}")
            foreach(_library IN LISTS _lvui_dependencies)
                get_filename_component(_name "${_library}" NAME)
                _lvui_patch_elf("${_lvui_app_dir}/${_name}")
            endforeach()
        endif()
    endif()
else()
    message(FATAL_ERROR "Invalid LVUI application installation phase")
endif()
