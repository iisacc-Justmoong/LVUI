@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiSDKCore 0.18.1 CONFIG COMPONENTS Contracts Observation)
include("${CMAKE_CURRENT_LIST_DIR}/LVUICoreObservation.cmake")
find_dependency(iiColorManager 0.1.1 CONFIG COMPONENTS Values)
include("${CMAKE_CURRENT_LIST_DIR}/LVUITargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LVUIAot.cmake")
set(LVUI_Native_FOUND TRUE)
set(LVUI_Compiler_FOUND TRUE)
if("Color" IN_LIST LVUI_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LVUIColorTargets.cmake")
        find_dependency(iiColorManager 0.1.1 CONFIG COMPONENTS iiColorManager)
        include("${CMAKE_CURRENT_LIST_DIR}/LVUIColorTargets.cmake")
        set(LVUI_Color_FOUND TRUE)
    else()
        set(LVUI_Color_FOUND FALSE)
    endif()
endif()
if("Runtime" IN_LIST LVUI_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LVUIRuntimeTargets.cmake")
        find_dependency(iiSDKCore 0.20 CONFIG COMPONENTS Runtime)
        include("${CMAKE_CURRENT_LIST_DIR}/LVUIRuntimeTargets.cmake")
        set(LVUI_Runtime_FOUND TRUE)
    else()
        set(LVUI_Runtime_FOUND FALSE)
    endif()
endif()
check_required_components(LVUI)
