@PACKAGE_INIT@
if(EMSCRIPTEN)
    # Emscripten supports side modules although its CMake toolchain defaults
    # the shared-library capability to false.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
set(_lvui_core_profile "@LVUI_CORE_PROFILE_HINT@")
if(_lvui_core_profile)
    find_dependency(iiSDKCore 0.18.1 CONFIG COMPONENTS Contracts Observation
        HINTS "${PACKAGE_PREFIX_DIR}/../iiSDKCore/${_lvui_core_profile}")
else()
    find_dependency(iiSDKCore 0.18.1 CONFIG COMPONENTS Contracts Observation)
endif()
unset(_lvui_core_profile)
include("${CMAKE_CURRENT_LIST_DIR}/LVUICoreObservation.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LVUITargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LVUIAot.cmake")
# Explicit capability for consumers that still carry legacy AOT fixtures.
set(LVUI_AOT_FRAMEWORKS "iiGUI")
set(LVUI_IIGUI_MIN_VERSION "0.5.0")
set(LVUI_Native_FOUND TRUE)
set(LVUI_Compiler_FOUND TRUE)
set(LVUI_CompilerBridge_FOUND TRUE)
if("Localization" IN_LIST LVUI_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LVUILocalizationTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/LVUILocalizationTargets.cmake")
        set(LVUI_Localization_FOUND TRUE)
    else()
        set(LVUI_Localization_FOUND FALSE)
    endif()
endif()
if("Color" IN_LIST LVUI_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LVUIColorTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/LVUIColorTargets.cmake")
        set(LVUI_Color_FOUND TRUE)
    else()
        set(LVUI_Color_FOUND FALSE)
    endif()
endif()
if("Runtime" IN_LIST LVUI_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LVUIRuntimeTargets.cmake")
        find_dependency(iiSDKCore 0.20 CONFIG COMPONENTS Runtime)
        include("${CMAKE_CURRENT_LIST_DIR}/LVUIRuntimeTargets.cmake")
        set(LVUI_Runtime_FOUND TRUE)
    else()
        set(LVUI_Runtime_FOUND FALSE)
    endif()
endif()
if("ImageIO" IN_LIST LVUI_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LVUIImageIOTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/LVUIImageIOTargets.cmake")
        set(LVUI_ImageIO_FOUND TRUE)
    else()
        set(LVUI_ImageIO_FOUND FALSE)
    endif()
endif()
check_required_components(LVUI)
