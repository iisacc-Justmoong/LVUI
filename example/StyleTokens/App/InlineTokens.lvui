var distance: Metric = .space8
ApplicationWindow(title: "LVUI inline tokens", backgroundColor: Color.window,
                  fontFamily: token("--lvrs-theme-typography-font-font-body")) {
    VStack(id: "inline-panel", width: 400, height: 240, gap: Metric.space12,
           padding: .space24, backgroundColor: .window, cornerRadius: Metric.radius6) {
        Label(id: "inline-body", text: "Inline native tokens", fontSize: Metric.textBody,
              fontWeight: .weightMedium, lineHeight: Metric.textBodyLineHeight, color: Color.text.body)
        Slider(id: "distance", from: 0, to: 20, value: distance)
    }
}
