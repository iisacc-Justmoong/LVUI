          "checked": null
        }
      ]
    },
    {
      "id": "b000052",
      "kind": "blank",
      "start_line": 96,
      "end_line": 96,
      "raw": "\n"
    },
    {
      "id": "b000053",
      "kind": "paragraph",
      "start_line": 97,
      "end_line": 97,
      "raw": "정확히 생성할 요청 타입과 뷰 측 인자·결과 변환은 정해야 할 구현 세부사항이다.\n"
    },
    {
      "id": "b000054",
