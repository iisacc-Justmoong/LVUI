    },
    {
      "id": "b000035",
      "kind": "heading",
      "start_line": 72,
      "end_line": 72,
      "raw": "## 빌드 시 책임\n",
      "level": 2,
      "title": "빌드 시 책임"
    },
    {
      "id": "b000036",
