import counter CounterBackend

ApplicationWindow(title: "Counter", accent: .blue) {
    VStack(spacing: 16) {
        Label(text: "Counter")
        Label(text: counter.value)

        HStack(spacing: 12) {
            PushButton(counter.decrement) {
                text: "−"
                tone: .borderless
            }

            PushButton(counter.increment) {
                text: "+"
                tone: .borderless
            }
        }
    }
}
